{
  "input_model": {
    "type": "OnnxModel",
    "model_path": "artifacts/olive-recipe/whisper-base-en_cpu_int8",
    "onnx_file_name": "decoder.onnx"
  },
  "data_configs": [
    {
      "name": "librispeech_test_clean",
      "type": "HuggingfaceContainer",
      "load_dataset_config": {
        "type": "huggingface_dataset",
        "params": {
          "data_name": "hf-audio/esb-datasets-test-only-sorted",
          "subset": "librispeech",
          "split": "test.clean"
        }
      },
      "pre_process_data_config": {
        "type": "speech_transcription_pre_process",
        "params": {
          "audio_col": "audio",
          "text_col": "text",
          "sample_rate": 16000,
          "max_samples": 64
        }
      }
    }
  ],
  "evaluators": {
    "common_evaluator": {
      "metrics": [
        {
          "name": "speech_accuracy",
          "type": "accuracy",
          "data_config": "librispeech_test_clean",
          "sub_types": [
            {
              "name": "wer",
              "priority": 1,
              "higher_is_better": false
            },
            {
              "name": "rtfx",
              "priority": 2,
              "higher_is_better": true
            }
          ]
        }
      ]
    }
  },
  "systems": {
    "local_system": {
      "type": "LocalSystem",
      "accelerators": [
        {
          "device": "cpu",
          "execution_providers": ["CPUExecutionProvider"]
        }
      ]
    }
  },
  "engine": {
    "host": "local_system",
    "target": "local_system",
    "evaluator": "common_evaluator"
  }
}
